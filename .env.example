# TradeGuard AI - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ------------------------------------------------------------------
# TRADING MODE
# ------------------------------------------------------------------
# "paper" (default) - Simulated trading, no real money
# "live" - Real trading with actual funds (DANGEROUS)
TRADING_MODE=paper

# ------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------
# Path to SQLite database (optional, defaults to data/trades.db)
# ROBO_SHOPPER_DB=/path/to/trades.db

# ------------------------------------------------------------------
# BINANCE API CREDENTIALS (Required for live mode)
# ------------------------------------------------------------------
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# 
# SAFETY: 
# - Use Testnet keys for development: https://testnet.binance.vision/
# - NEVER share your API keys
# - NEVER commit .env to git
# - Enable IP restrictions on your API keys
# - Disable withdrawal permissions

# Binance API Key
BINANCE_API_KEY=your_api_key_here

# Binance API Secret
BINANCE_API_SECRET=your_api_secret_here

# Use Mainnet (true) or Testnet (false, default)
# WARNING: true = REAL MONEY AT RISK
BINANCE_USE_MAINNET=false

# ------------------------------------------------------------------
# LLM CONFIGURATION (Optional)
# ------------------------------------------------------------------
# OpenAI API Key (for Qwen agent)
# OPENAI_API_KEY=your_openai_key_here

# ------------------------------------------------------------------
# DASHBOARD CONFIGURATION (Optional)
# ------------------------------------------------------------------
# Dashboard API Key
# DASHBOARD_API_KEY=your_dashboard_key_here

# Session Secret
# SESSION_SECRET=your_session_secret_here

# ------------------------------------------------------------------
# DEVELOPMENT MODE
# ------------------------------------------------------------------
# Enable development mode (1) or production mode (0)
DEV_MODE=1