# TradeGuard AI - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ------------------------------------------------------------------
# TRADING MODE
# ------------------------------------------------------------------
# "paper" (default) - Simulated trading, no real money
# "live" - Real trading with actual funds (DANGEROUS)
TRADING_MODE=paper

# ------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------
# Path to SQLite database (optional, defaults to data/trades.db)
# TRADEGUARD_DB=/path/to/trades.db

# ------------------------------------------------------------------
# BINANCE API CREDENTIALS (Required for live mode only)
# ------------------------------------------------------------------
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# 
# SAFETY: 
# - Use Testnet keys for development: https://testnet.binance.vision/
# - NEVER share your API keys
# - NEVER commit .env to git
# - Enable IP restrictions on your API keys
# - Disable withdrawal permissions

# Binance API Key (required only if TRADING_MODE=live)
BINANCE_API_KEY=

# Binance API Secret (required only if TRADING_MODE=live)
BINANCE_API_SECRET=

# Use Binance Testnet (true, default) or Mainnet (false)
# WARNING: false = REAL MONEY AT RISK
BINANCE_USE_TESTNET=true

# ------------------------------------------------------------------
# DEVELOPMENT MODE
# ------------------------------------------------------------------
# Enable development mode (1) or production mode (0)
DEV_MODE=1